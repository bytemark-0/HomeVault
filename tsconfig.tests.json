{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "/private/tmp/homevault-package-tests",
    "paths": {
      "@homevault/database": ["packages/database/src"],
      "@homevault/domain": ["packages/domain/src"],
      "@homevault/export": ["packages/export/src"],
      "@homevault/ocr": ["packages/ocr/src"],
      "@homevault/sync": ["packages/sync/src"],
      "@homevault/ui": ["packages/ui/src"]
    },
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
